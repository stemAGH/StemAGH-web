# Set in the host's Production environment (Vercel: Project Settings > Environment Variables).
# Enables canonical links, og:image, a Twitter card and the sitemap. Not secret.
# Must be an https origin with no path and no trailing slash. A Vercel production
# build fails if it is missing; any invalid value fails the build with a clear message.
# SITE_URL=https://www.stemagh.com

# Project enquiry form (/contact). Optional: without these the form falls back to a prepared
# email draft, so no enquiry is lost. Set in Production (and Preview if you want to test there).
# RESEND_API_KEY is a secret: create it at resend.com after verifying your sending domain.
# RESEND_API_KEY=re_xxx
# CONTACT_FROM="StemAGH website <website@stemagh.com>"
# CONTACT_TO=contact@stemagh.com
