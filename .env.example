# Set in the host's Production environment (Vercel: Project Settings > Environment Variables).
# Enables canonical links, og:image, a Twitter card and the sitemap. Not secret.
# Must be an https origin with no path and no trailing slash. A Vercel production
# build fails if it is missing; any invalid value fails the build with a clear message.
# SITE_URL=https://www.stemagh.com

# Project enquiry form (/contact, /hello). Emails CONTACT_TO (default contact@stemagh.com).
# First configured option wins (docs/launch.md section 5):
# 1. SMTP from our own mailbox (recommended). SMTP_PASS is a secret: for Lark Mail, an IMAP/SMTP
#    password from Lark Mail settings, not the account password.
# SMTP_HOST=smtp.larksuite.com
# SMTP_PORT=465
# SMTP_USER=contact@stemagh.com
# SMTP_PASS=
# 2. Resend: RESEND_API_KEY (secret) + CONTACT_FROM on a domain verified in Resend.
# 3. Nothing set: the visitor's browser relays through FormSubmit (free, no guarantees).
# CONTACT_DELIVERY=off disables sending (the test server uses it).
# RESEND_API_KEY=re_xxx
# CONTACT_FROM="StemAGH website <website@stemagh.com>"
# CONTACT_TO=contact@stemagh.com
